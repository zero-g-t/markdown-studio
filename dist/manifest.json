{
  "manifest_version": 3,
  "name": "Markdown Studio",
  "description": "A local-first Markdown editor with directory tree, live preview, outline navigation, and autosave.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open Markdown Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
