{
  "manifest_version": 3,
  "name": "Markdown Studio",
  "description": "A local-first Markdown editor with directory tree, live preview, outline, autosave, plus Feishu doc to Markdown download.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open Markdown Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "file:///*",
    "https://*.feishu.cn/*",
    "https://*.feishu.net/*",
    "https://*.larksuite.com/*",
    "https://*.feishu-pre.net/*",
    "https://*.larkoffice.com/*",
    "https://*.larkenterprise.com/*"
  ],
  "permissions": ["storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["open-md-file.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.feishu.cn/*",
        "https://*.feishu.net/*",
        "https://*.larksuite.com/*",
        "https://*.feishu-pre.net/*",
        "https://*.larkoffice.com/*",
        "https://*.larkenterprise.com/*"
      ],
      "js": ["bundles/feishu-content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
