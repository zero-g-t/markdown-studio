{
  "manifest_version": 3,
  "name": "Markdown Studio",
  "description": "A local-first Markdown editor with directory tree, live preview, outline, autosave, plus web page (and Feishu doc) to Markdown download.",
  "version": "0.2.0",
  "action": {
    "default_title": "Open Markdown Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "file:///*",
    "http://*/*",
    "https://*/*"
  ],
  "permissions": ["storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["open-md-file.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bundles/feishu-content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
